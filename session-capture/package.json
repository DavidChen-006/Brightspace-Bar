{
  "name": "session-capture",
  "private": true,
  "type": "module",
  "description": "Capture a live Brightspace session without handling a password",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bsb": "src/bsb.mjs"
  },
  "scripts": {
    "start": "node src/start.mjs",
    "login": "node src/start.mjs --visible",
    "xsrf": "node src/refresh-xsrf.mjs",
    "refresh": "node src/refresh.mjs",
    "bsb": "node src/bsb.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
