# Brightspace Bar daemon — environment variables (all optional).
#
# Normally you set NONE of these: `make start` prompts once and stores
# credentials in <BSB_ROOT>/credentials.json (mode 0600). Env vars are the
# override / CI path. Never commit real values — `.env` files are gitignored
# (see the repo-root .gitignore); this .env.example is the only tracked one.

# Credentials for the full-login rung's autofill. Env wins only when BOTH are
# set; otherwise credentials.json is used. Override path only — prefer the
# `make start` prompt, which keeps the password out of shell history.
BS_EMAIL=alice@purdue.edu
BS_PASSWORD=example-not-a-real-password

# Brightspace tenant base URL (default: https://purdue.brightspace.com).
BS_BASE_URL=https://purdue.brightspace.com

# Root for all daemon state (profile/, session.json, credentials.json, cache/).
# Default: ~/Library/Application Support/BrightspaceBar. Tests point this at a
# temp dir for isolation.
BSB_ROOT=/tmp/bsb-test-root

# Path to the deep-link opener CLI the Swift app spawns on a click
# (default: the sibling session-capture/src/browser-open.mjs).
BSB_OPEN_CLI=/path/to/session-capture/src/browser-open.mjs

# Path to the refresh CLI the Swift app spawns to update the cache
# (default: the sibling session-capture/src/refresh.mjs).
BSB_REFRESH_CLI=/path/to/session-capture/src/refresh.mjs

# CDP port the click-opened Chromium listens on (localhost only), used to add
# tabs to the already-running browser. Default: 9223.
BSB_OPEN_CDP_PORT=9223

# Which browser clicks open in: "chromium" (the daemon's signed-in profile,
# the default) or "system" (your default browser).
BSB_BROWSER_TARGET=chromium

# Set to 1 to run the full-login rung with a visible browser window
# (debugging escape hatch; default is headless — the MFA number shows on the
# menu-bar icon instead).
BSB_FULL_HEADED=0

# Test-only gates (not read by the daemon at runtime):
#   BS_LIVE=1              — enables live-tenant tests (`make live`)
#   BRIGHTSPACEBAR_STUB=1  — runs the Swift app against stub data
